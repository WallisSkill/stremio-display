{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiS TV",
  "version": "0.1.0",
  "identifier": "tv.wis.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WiS TV",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1M0Q0MDdBRTQ4ODlFMzkKUldRNW5vamtla0E5QmVrVjUwaUx0cXFtRDJpbWp1UFpJRjR3bDlLSnFldGJBZFdyL0NxQWVjSUoK",
      "endpoints": [
        "https://github.com/WallisSkill/stremio-display/releases/download/{{target}}/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
